<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caliperforge.tick</string>

  <!-- launchd will not overlap its own job, so the job is the launcher and not the tick it starts. -->
  <!-- #168: the pinned worktree, never /Users/michael/cf_v2, which is the tree people work in. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/michael/cf_v2_tick/launchd/tick.sh</string>
  </array>

  <!-- Without this launchd kills the tick the launcher left running behind it. -->
  <key>AbandonProcessGroup</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/michael/cf_v2_tick</string>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- The receipt is the `ticks` row `cf tick` writes; stdout and stderr go nowhere on purpose. -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/michael/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
