{
  "name": "caliperforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cf": "cli/cf.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "checks": "node checks/run.ts .",
    "tight": "node cli/cf.ts tight",
    "digests": "node cli/cf.ts digests --check",
    "check": "npm run typecheck && npm run lint && npm run test && npm run checks && npm run digests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
